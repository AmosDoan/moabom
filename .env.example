# 모아봄 환경변수 — 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env

# 로그인 아이디 (원하는 값으로)
ASSET_USER=admin

# 로그인 초기 비밀번호 (반드시 강한 값으로 변경! 로그인 후 웹에서도 바꿀 수 있음)
ASSET_PASSWORD=change-this-password

# (선택) 구글 시트에서 주식 외 자산을 '읽어와' 대시보드에 합산할 시트 ID. 안 쓰면 비움.
ASSET_SHEET_ID=

# (선택) 매일 주식 평가액을 구글 시트 'Stock' 탭에 '백업 저장'할 시트 ID.
#   서비스 계정(data/gsa.json)에 해당 시트 '편집자' 권한이 있어야 합니다. 안 쓰면 비움.
ASSET_BACKUP_SHEET_ID=

# 시간대
TZ=Asia/Seoul
